{
  "name": "@hightech/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --no-warnings --import tsx --watch src/main.ts",
    "start": "node --no-warnings --import tsx src/main.ts",
    "seed": "node --no-warnings --import tsx src/seed.ts",
    "test": "node --no-warnings --import tsx --test src/*.test.ts",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@hightech/commission": "1.0.0",
    "express": "^4.21.0",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0"
  }
}
