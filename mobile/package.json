{
  "name": "@hightech/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:retail": "EXPO_PUBLIC_APP_VARIANT=retail expo start",
    "start:wholesale": "EXPO_PUBLIC_APP_VARIANT=wholesale expo start",
    "web": "expo start --web",
    "export:web:retail": "EXPO_PUBLIC_APP_VARIANT=retail expo export --platform web --output-dir dist/retail",
    "export:web:wholesale": "EXPO_PUBLIC_APP_VARIANT=wholesale expo export --platform web --output-dir dist/wholesale",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hightech/commission": "1.0.0",
    "expo": "~58.0.26",
    "expo-router": "~58.0.32",
    "react-native": "0.88.1",
    "react": "19.3.0",
    "expo-secure-store": "~58.0.3",
    "expo-clipboard": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-notifications": "~58.1.9",
    "expo-constants": "~58.0.16",
    "expo-device": "~58.0.5",
    "@react-native-async-storage/async-storage": "2.2.0",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "expo-status-bar": "~58.0.5",
    "react-native-web": "~0.21.4",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/react": "^19.3.0"
  }
}
